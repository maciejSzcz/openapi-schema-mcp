{
  "name": "openapi-schema-mcp",
  "version": "0.1.0",
  "description": "Stdio MCP server that exposes an OpenAPI spec's operations as MCP resources.",
  "type": "module",
  "private": true,
  "bin": {
    "openapi-schema-mcp": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun ./src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/yargs": "^17.0.35"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^4.1.1",
    "openapi-types": "^12.1.3",
    "yargs": "^18.0.0"
  }
}

{
  "name": "openapi-schema-mcp",
  "version": "0.3.0",
  "description": "Stdio MCP server that exposes an OpenAPI spec's operations as deferred MCP tools — keyword-discoverable, context-light schema lookup.",
  "type": "module",
  "bin": {
    "openapi-schema-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "stdio",
    "llm",
    "ai"
  ],
  "author": "Maciej Szczęsny <szczesnymcj@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/maciejSzcz/openapi-schema-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maciejSzcz/openapi-schema-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/maciejSzcz/openapi-schema-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "bun ./src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target node --format esm --banner \"#!/usr/bin/env node\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/yargs": "^17.0.35",
    "js-yaml": "^4.1.1",
    "openapi-types": "^12.1.3",
    "typescript": "^5",
    "yargs": "^18.0.0"
  }
}
